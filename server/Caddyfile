secureshare-relay.duckdns.org {
	# Security headers (global defaults)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	# Health check endpoint — proxy to relay
	handle /health {
		header Content-Security-Policy "default-src 'none'"
		reverse_proxy relay:8766
	}

	# Public version endpoint — cacheable, no auth needed
	handle /api/version {
		header Content-Security-Policy "default-src 'none'"
		header Cache-Control "public, max-age=300"
		reverse_proxy relay:8766
	}

	# API endpoints — proxy to relay (crash reports, telemetry, admin)
	handle /api/* {
		header Content-Security-Policy "default-src 'none'"
		header Cache-Control "no-store"
		reverse_proxy relay:8766 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Admin dashboard — static page + API calls
	handle /admin {
		header Content-Security-Policy "default-src 'self'; script-src 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
		root * /www
		rewrite * /admin.html
		file_server
	}

	# App download — stable aliases redirected to latest GitHub release assets
	handle /download/SecureShare.zip {
		header Content-Security-Policy "default-src 'none'"
		redir https://github.com/artmarchenko/SecureShare/releases/latest/download/SecureShare.zip 302
	}
	handle /download/SecureShare-linux-x64.tar.gz {
		header Content-Security-Policy "default-src 'none'"
		redir https://github.com/artmarchenko/SecureShare/releases/latest/download/SecureShare-linux-x64.tar.gz 302
	}
	# Android: Android releases are not GitHub's "latest" (that is the desktop
	# app), so release-android.yml uploads the APK here (./downloads on the VPS).
	handle /download/SecureShare.apk {
		header Content-Security-Policy "default-src 'none'"
		root * /downloads
		@uploaded file /SecureShare.apk
		@missing not file /SecureShare.apk
		header @uploaded Content-Type "application/vnd.android.package-archive"
		header @uploaded Content-Disposition "attachment; filename=SecureShare.apk"
		header @uploaded Cache-Control "no-cache"
		rewrite @uploaded /SecureShare.apk
		file_server @uploaded
		# not uploaded yet: the releases page
		redir @missing https://github.com/artmarchenko/SecureShare/releases 302
	}
	# Fallback for any unknown download path.
	handle /download/* {
		header Content-Security-Policy "default-src 'none'"
		redir https://github.com/artmarchenko/SecureShare/releases/latest 302
	}

	# Android App Links: lets invitation links open the app directly.
	# Must match mobile/android/release-cert.sha256 (tests check it).
	handle /.well-known/assetlinks.json {
		header Content-Security-Policy "default-src 'none'"
		header Content-Type "application/json"
		root * /www
		rewrite * /assetlinks.json
		file_server
	}

	# Invitation page /r#<code> (the code stays in the fragment, never sent here)
	handle /r {
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'"
		header Cache-Control "no-cache"
		header X-Robots-Tag "noindex"
		root * /www
		rewrite * /r.html
		file_server
	}

	# WebSocket relay — proxy only WS connections
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy relay:8765 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Landing page — static site (everything else)
	handle {
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; connect-src 'self'"
		root * /www
		file_server
	}
}
